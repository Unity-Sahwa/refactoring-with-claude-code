{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ab0c7fec55534703ba3c90fe6f43fedf",
    "m_Title": "문제 개선",
    "m_Content": "Opaque + Alpha Clip 사용 이유:\nTransparent는 ZWrite Off라 나무가 겹칠 때\n피벗 거리 순으로만 정렬돼 앞뒤가 뒤바뀜.\nOpaque는 ZWrite 유지 → 정렬 문제 없음.\n반투명이 안 되므로 Dither로 대체함.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1115.0,
        "y": 615.0,
        "width": 491.0,
        "height": 153.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

